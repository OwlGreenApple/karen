# === Binance ===
BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here
# start in testnet for safety
BINANCE_TESTNET=true

# === Master Switches (hot-reloadable) ===
# global kill switch
TRADING_ENABLED=false
# mean_reversion | trend_following
STRATEGY_MODE=mean_reversion

# === Trading Pairs ===
SYMBOLS=BTCUSDT,ETHUSDT,DOTUSDT,HYPEUSDT,AAVEUSDT,DOGEUSDT,XRPUSDT,BNBUSDT,ALGOUSDT

# === Risk (hot-reloadable) ===
# Leverage: otomatis 5x-20x per trade dari confidence sinyal (tidak diatur di sini)
# Margin per entry: POSITION_SIZE_PCT dari saldo available (default 100)
# % of equity risked per trade
RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_POSITIONS=1
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=25

# === Strategy params (hot-reloadable) ===
MR_BB_PERIOD=20
MR_BB_STD=2.0
MR_RSI_PERIOD=14
MR_RSI_OVERSOLD=30
MR_RSI_OVERBOUGHT=70
MR_ADX_MAX=20

TF_EMA_FAST=21
TF_EMA_MID=50
TF_EMA_SLOW=200
TF_ADX_MIN=25
TF_VOLUME_MULTIPLIER=1.2

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id

# === Dashboard ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_URL=http://localhost:8000
