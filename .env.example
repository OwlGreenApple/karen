# === Binance ===
BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here
BINANCE_TESTNET=true               # start in testnet for safety

# === Master Switches (hot-reloadable) ===
TRADING_ENABLED=false              # global kill switch
STRATEGY_MODE=mean_reversion       # mean_reversion | trend_following

# === Trading Pairs ===
SYMBOLS=BTCUSDT,ETHUSDT,DOTUSDT,HYPEUSDT,AAVEUSDT,DOGEUSDT,XRPUSDT,BNBUSDT,ALGOUSDT

# === Risk (hot-reloadable) ===
LEVERAGE=5
RISK_PER_TRADE_PCT=1.0             # % of equity risked per trade
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=25

# === Strategy params (hot-reloadable) ===
MR_BB_PERIOD=20
MR_BB_STD=2.0
MR_RSI_PERIOD=14
MR_RSI_OVERSOLD=30
MR_RSI_OVERBOUGHT=70
MR_ADX_MAX=20

TF_EMA_FAST=21
TF_EMA_MID=50
TF_EMA_SLOW=200
TF_ADX_MIN=25
TF_VOLUME_MULTIPLIER=1.2

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id

# === Dashboard ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_URL=http://localhost:8000
